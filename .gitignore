# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*.egg-info/
.venv/
.pytest_cache/

# --- Raw/processed datasets (large -- fetched by scripts/download_data.py) ---
data/raw/
data/processed/

# --- Run artifacts, not the codebase itself (regenerated by scripts/*.ps1) ---
figures/
results/
logs/
notebooks/
third_party/

# --- Internal dev logs / superseded ad-hoc scripts (R&D history, not paper-scoped) ---
MODEL_REPORT.md
MODEL_REPORT_FULL_HISTORY.md
RUNBOOK.md
/run_all_experiments.*
/run_leftover_experiments.*
/run_plm_vs_mint_comparison.*
/run_mint_own_method.*
/run_mint_split_eval.*
/*_log.txt
/scratch_*.txt

# --- Loose experiment-output JSONs/CSVs sitting at the repo root ---
/*.json
/*.csv
!checkpoints/*.json

# --- Paper source (separate from the code repo) ---
paper/

# --- Editor / tool config ---
.claude/
.vscode/

# --- OS cruft ---
.DS_Store
Thumbs.db
